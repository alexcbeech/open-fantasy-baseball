{
  "name": "open-fantasy-baseball",
  "version": "0.1.0",
  "private": true,
  "description": "Open Fantasy Baseball, a mobile-first fantasy baseball app inspired by familiar fantasy sports workflows.",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:migrate": "node scripts/migrate.mjs",
    "db:seed": "node scripts/seed.mjs",
    "db:setup": "npm run db:migrate && npm run db:seed",
    "jobs:nightly": "tsx scripts/run-nightly.ts",
    "jobs:run": "tsx scripts/run-jobs.ts",
    "sync:mlb": "tsx scripts/sync-mlb.ts",
    "sync:schedule": "tsx scripts/sync-schedule.ts",
    "sync:stats": "tsx scripts/sync-stats.ts",
    "sync:bios": "tsx scripts/sync-bios.ts",
    "sync:projections": "tsx scripts/sync-projections.ts",
    "sync:adp": "tsx scripts/sync-adp.ts",
    "sync:news": "tsx scripts/sync-news.ts",
    "eligibility:offseason": "tsx scripts/reconcile-position-eligibility.ts",
    "sync:matchups": "tsx scripts/sync-matchups.ts",
    "seed:opponent": "tsx scripts/seed-opponent.ts"
  },
  "dependencies": {
    "@neondatabase/auth": "0.5.0-beta",
    "next": "^16.3.1",
    "pg": "^8.13.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.20.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/web-push": "^3.6.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.0",
    "tsx": "^4.23.9",
    "typescript": "^5.8.3",
    "vitest": "^4.1.10"
  }
}
